# =====================================================================
#  Rimetra — ortam ayarları
#  Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:
#      cp .env.example .env
#  .env dosyası git tarafından yok sayılır (.gitignore), sunucuya
#  çektiğinizde kendi .env dosyanız korunur.
# =====================================================================

# ---------------------------------------------------------------------
#  Uygulama
# ---------------------------------------------------------------------
# Tarayıcıdan erişeceğiniz port (host tarafı). http://<sunucu-ip>:8080
APP_PORT=8080

# Zaman dilimi (tarih/saat gösterimi ve yedekleme saati için)
TZ=Europe/Istanbul

# Oturum imzalama ve önizleme jetonları için gizli anahtar.
# Aşağıdaki örnek değerler bırakılırsa uygulama güvenlik için AÇILMAZ.
# Üretmek için:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=degistir-bunu-uzun-rastgele-bir-deger-yap

# PDF'leri ve yedekleri diskte şifrelemek için anahtar (herhangi bir uzun rastgele metin).
# DİKKAT: Bu anahtarı kaybederseniz şifreli PDF'ler ve yedekler AÇILAMAZ.
# Güvenli bir yere (parola yöneticisi vb.) not edin.
# Üretmek için:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_ENCRYPTION_KEY=degistir-bunu-da-uzun-rastgele-bir-deger-yap

# Oturum çerezinde "Secure" bayrağı. Yalnızca HTTPS arkasında true yapın.
# Yerel ağda düz HTTP ile çalışırken false OLMALI, yoksa giriş yapılamaz.
COOKIE_SECURE=false

# Oturum süresi (saat)
SESSION_HOURS=168

# API anahtarı başına dakikadaki istek sınırı
API_RATE_LIMIT_PER_MINUTE=60

# Başarısız girişte artan bekleme: ilk kaç denemeden sonra devreye girsin
LOGIN_FAILS_BEFORE_DELAY=3

# Yüklenebilecek en büyük PDF boyutu (MB)
MAX_PDF_MB=25

# Silinen raporlar kaç gün geri alınabilir (sonra kalıcı silinir)
REPORT_RESTORE_DAYS=30

# Uygulamanın dışarıdan görünen adresi (MCP/API örneklerinde gösterilir).
# Örn: http://192.168.1.50:8080
PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------
#  İlk master kullanıcı (isteğe bağlı)
#  Doldurulursa ilk açılışta, hiç master yoksa otomatik oluşturulur.
#  Boş bırakırsanız: docker compose exec app rimetra create-master
#  İlk girişten sonra bu iki satırı boşaltmanız önerilir.
# ---------------------------------------------------------------------
INITIAL_MASTER_USERNAME=
INITIAL_MASTER_PASSWORD=
# Master'ın kendi profil adı (aile panelinde görünür). Boşsa profil oluşturulmaz.
INITIAL_MASTER_DISPLAY_NAME=

# ---------------------------------------------------------------------
#  Veritabanı (PostgreSQL 16 — aynı stack içinde "db" servisi)
# ---------------------------------------------------------------------
POSTGRES_DB=rimetra
POSTGRES_USER=rimetra
# Üretmek için:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=degistir-veritabani-sifresi

# ---------------------------------------------------------------------
#  Veri klasörü (host tarafı) — PDF'ler, avatarlar ve yedekler burada durur
# ---------------------------------------------------------------------
DATA_DIR=./data

# ---------------------------------------------------------------------
#  Yedekleme
# ---------------------------------------------------------------------
BACKUP_ENABLED=true
# Günlük yedeğin alınacağı saat (0-23, TZ'ye göre)
BACKUP_HOUR=3
# Kaç gün saklansın
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------
#  Telegram botu (isteğe bağlı)
#  1) Telegram'da @BotFather → /newbot → verdiği anahtarı aşağıya yazın.
#  2) docker compose up -d   (Portainer: stack → Update)
#  3) Rimetra → sağ üstte profil menüsü → "Telegram'ı bağla".
#  Bot Telegram'a kendisi bağlanır (long polling): HTTPS veya port açmak gerekmez.
#  Boş bırakılırsa bot kapalıdır.
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Yeni tahlil eklenince bağlı kullanıcılara bildirim gönderilsin mi (herkes kendi
# bildirimini ayrıca açıp kapatabilir)
TELEGRAM_NOTIFY=true
